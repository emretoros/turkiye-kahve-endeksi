---
import '../styles/global.css';
import '../styles/fancy.css';
import '../styles/access.css';
import metadata from '../../public/data/metadata.json';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const number = new Intl.NumberFormat('tr-TR');
const checkedDate = new Date(`${metadata.checkedAt}T12:00:00+03:00`);
const checkedShort = new Intl.DateTimeFormat('tr-TR').format(checkedDate);
const checkedLong = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).format(checkedDate);
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Türkiye'deki kahve kavurucularını ve satıştaki çekirdekleri keşfedin; menşe, gramaj ve fiyat bilgilerini karşılaştırın." />
    <title>Çekirdek Bul</title>
  </head>
  <body class="is-locked" data-base={base}>
    <div class="access-gate" id="access-gate">
      <section class="access-card" role="dialog" aria-modal="true" aria-labelledby="access-title">
        <div class="access-brand"><span class="brand-mark">ÇB</span><span>Çekirdek Bul</span></div>
        <p class="access-eyebrow">Özel erişim</p>
        <h2 id="access-title">İstediğiniz kahveyi<br/><em>bulmak zor değil</em></h2>
        <p class="access-copy">Devam etmek için giriş şifresini yazın.</p>
        <form class="access-form" id="access-form" novalidate>
          <label for="access-password">Şifre</label>
          <div class="access-field">
            <input id="access-password" name="password" type="password" autocomplete="current-password" aria-describedby="access-error" required />
            <button type="submit">Giriş yap</button>
          </div>
          <p class="access-error" id="access-error" role="alert" aria-live="polite"></p>
        </form>
        <noscript><p class="access-noscript">Giriş ekranı için tarayıcınızda JavaScript'i etkinleştirmeniz gerekir.</p></noscript>
      </section>
    </div>
    <header class="hero">
      <nav class="nav shell">
        <a class="brand" href={base} aria-label="Çekirdek Bul ana sayfa">
          <span class="brand-mark">ÇB</span><span>Çekirdek Bul</span>
        </a>
        <span class="nav-count" id="nav-count">{number.format(metadata.businesses)} kavurucu · {number.format(metadata.namedProducts)} ürün</span>
      </nav>
      <div class="hero-content shell">
        <p class="eyebrow">Türkiye'nin bağımsız çekirdek radarı</p>
        <h1 id="site-title" tabindex="-1">İstediğiniz kahveyi<br/><em>bulmak zor değil</em></h1>
        <p class="hero-copy" id="hero-copy">Türkiye'deki kavurucuların çekirdeklerini tek yerde keşfedin. Menşeyi seçin, fiyatı karşılaştırın, doğru çekirdeğe doğrudan ulaşın.</p>
        <div class="hero-actions">
          <a class="button primary" href="#urunler">Çekirdeğini bul <span>↓</span></a>
        </div>
        <div class="stats" aria-label="Veri tabanı özeti">
          <div><strong id="stat-businesses">{number.format(metadata.businesses)}</strong><span>işletme</span></div>
          <div><strong id="stat-products">{number.format(metadata.namedProducts)}</strong><span>doğrulanmış ürün</span></div>
          <div><strong id="stat-origins">{number.format(metadata.origins)}</strong><span>menşe sınıfı</span></div>
          <div><strong id="stat-last-control">{checkedShort}</strong><span>son tam kontrol</span></div>
        </div>
      </div>
    </header>

    <main>
      <section class="explorer shell" id="urunler">
        <div class="section-heading">
          <div><p class="eyebrow dark">Canlı veri görünümü</p><h2>Çekirdekleri keşfedin</h2></div>
          <p id="result-summary">Veriler hazırlanıyor…</p>
        </div>
        <div class="filters">
          <label class="search-field"><span>Arama</span><input id="search" type="search" placeholder="Ürün veya işletme ara…" /></label>
          <label><span>Menşe</span><select id="origin"><option value="">Tüm menşeler</option></select></label>
          <label><span>İşletme</span><select id="business"><option value="">Tüm işletmeler</option></select></label>
          <label><span>Fiyat değişimi</span><select id="price-change"><option value="">Tüm değişimler</option><option value="up">😟 Fiyatı arttı</option><option value="same">😐 Aynı kaldı</option><option value="down">😊 Fiyatı düştü</option><option value="unknown">Önceki fiyat yok</option></select></label>
          <label><span>Gramaj</span><select id="weight-range"><option value="">Tüm gramajlar</option><option value="lt250">250 g’dan küçük</option><option value="eq250">Tam 250 g</option><option value="gt250">250 g’dan büyük</option><option value="unknown">Gramaj bilgisi yok</option></select></label>
          <label><span>Sıralama</span><select id="sort"><option value="business">İşletme A–Z</option><option value="price-asc">Fiyat artan</option></select></label>
        </div>
        <div class="active-bar"><button id="clear" type="button">Filtreleri temizle</button><span id="price-update-summary">Her fiyat, ilgili kaynakta görülen kontrol tarihli değerdir.</span></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>İşletme</th><th>Ürün</th><th>Menşe</th><th>Gramaj</th><th>Güncel fiyat</th><th>Fiyat geçmişi</th><th>Kaynak</th></tr></thead>
            <tbody id="product-rows"><tr><td colspan="7" class="loading">Veri yükleniyor…</td></tr></tbody>
          </table>
        </div>
        <div class="pagination"><button id="prev" type="button">← Önceki</button><span id="page-label">1 / 1</span><button id="next" type="button">Sonraki →</button></div>
      </section>

    </main>
    <footer><div class="shell"><span>Çekirdek Bul</span><span id="footer-update">Son tam kontrol: {checkedLong}</span></div></footer>
    <script src={`${base}access.js`} defer></script>
  </body>
</html>
