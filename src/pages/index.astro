---
import '../styles/global.css';
import '../styles/fancy.css';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Türkiye'deki kahve kavurucularını ve satıştaki çekirdekleri keşfedin; menşe, gramaj ve fiyat bilgilerini karşılaştırın." />
    <title>Çekirdek Bul</title>
  </head>
  <body data-base={base}>
    <header class="hero">
      <nav class="nav shell">
        <a class="brand" href={base} aria-label="Çekirdek Bul ana sayfa">
          <span class="brand-mark">ÇB</span><span>Çekirdek Bul</span>
        </a>
        <span class="nav-count" id="nav-count">Kavurucu ve ürün verileri yükleniyor</span>
      </nav>
      <div class="hero-content shell">
        <p class="eyebrow">Türkiye'nin bağımsız çekirdek radarı</p>
        <h1>İyi kahve<br/><em>tesadüf değil.</em></h1>
        <p class="hero-copy" id="hero-copy">Türkiye'deki kavurucuların çekirdeklerini tek yerde keşfedin. Menşeyi seçin, fiyatı karşılaştırın, doğru çekirdeğe doğrudan ulaşın.</p>
        <div class="hero-actions">
          <a class="button primary" href="#urunler">Çekirdeğini bul <span>↓</span></a>
        </div>
        <div class="stats" aria-label="Veri tabanı özeti">
          <div><strong id="stat-businesses">151</strong><span>işletme</span></div>
          <div><strong id="stat-products">—</strong><span>doğrulanmış ürün</span></div>
          <div><strong id="stat-origins">65</strong><span>menşe sınıfı</span></div>
          <div><strong>11.08.2026</strong><span>son kontrol</span></div>
        </div>
      </div>
    </header>

    <main>
      <section class="explorer shell" id="urunler">
        <div class="section-heading">
          <div><p class="eyebrow dark">Canlı veri görünümü</p><h2>Çekirdekleri keşfedin</h2></div>
          <p id="result-summary">Veriler hazırlanıyor…</p>
        </div>
        <div class="filters">
          <label class="search-field"><span>Arama</span><input id="search" type="search" placeholder="Ürün veya işletme ara…" /></label>
          <label><span>Menşe</span><select id="origin"><option value="">Tüm menşeler</option></select></label>
          <label><span>İşletme</span><select id="business"><option value="">Tüm işletmeler</option></select></label>
          <label><span>Veri durumu</span><select id="data-status"><option value="">Tüm kayıtlar</option><option value="complete">Fiyat ve gramaj var</option><option value="price">Fiyat var</option><option value="weight">Gramaj var</option><option value="missing">Eksik alan var</option></select></label>
          <label><span>Sıralama</span><select id="sort"><option value="business">İşletme A–Z</option><option value="price-asc">Fiyat artan</option><option value="kg-asc">TL/kg artan</option><option value="kg-desc">TL/kg azalan</option></select></label>
        </div>
        <div class="active-bar"><button id="clear" type="button">Filtreleri temizle</button><span>Her fiyat, ilgili kaynakta görülen kontrol tarihli değerdir.</span></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>İşletme</th><th>Ürün</th><th>Menşe</th><th>Gramaj</th><th>Fiyat</th><th>TL/kg</th><th>Kaynak</th></tr></thead>
            <tbody id="product-rows"><tr><td colspan="7" class="loading">Veri yükleniyor…</td></tr></tbody>
          </table>
        </div>
        <div class="pagination"><button id="prev" type="button">← Önceki</button><span id="page-label">1 / 1</span><button id="next" type="button">Sonraki →</button></div>
      </section>

    </main>
    <footer><div class="shell"><span>Çekirdek Bul</span><span>Son kontrol: 11 Ağustos 2026</span></div></footer>
    <script src={`${base}app.js`} defer></script>
  </body>
</html>
